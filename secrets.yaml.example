# Copy to secrets.yaml and paste your tokens (secrets.yaml is gitignored).
#
#   cp configs/secrets.yaml.example configs/secrets.yaml

# Hugging Face — https://huggingface.co/settings/tokens
# Enable: "Make calls to Inference Providers"
huggingface_api_key: "hf_paste_your_token_here"

# DeepSeek — https://platform.deepseek.com/api_keys (free tier available)
# deepseek_api_key: "sk-..."

# OpenAI — https://platform.openai.com/api-keys
# openai_api_key: "sk-..."

# OpenRouter — https://openrouter.ai/keys (OpenAI-compatible; routes to GPT-4o etc.)
# openrouter_api_key: "sk-or-v1-..."

# Redis — carry store (optional; falls back to FakeRedis if server unreachable)
# redis_url: "redis://127.0.0.1:6379/0"
# huggingface_api_model: Qwen/Qwen3-32B-Instruct
